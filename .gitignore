node_modules/
dist/
*.tsbuildinfo

# Generated from proto/ — the .proto files are the source of truth.
# generated stubs are committed: one less setup step for a fresh clone
# (regenerate with `make proto`)
adapters/*/src/gen/

# Local runtime state. Never committed: it is the developer's data (Article IX).
*.db
*.db-wal
*.db-shm
.guard/

# The built binary at the repo root. Anchored with a leading slash: a bare
# `guard` also matches core/cmd/guard/, which silently swallowed a new source
# file until a clean clone failed to build.
/guard
